# --- Postgres ---
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=change-me-before-you-deploy
POSTGRES_DB=taskboard

# --- Application ---
ENVIRONMENT=development
APP_VERSION=dev
LOG_LEVEL=info
DATABASE_URL=postgresql+psycopg2://taskboard:change-me-before-you-deploy@db:5432/taskboard

# --- Grafana (monitoring profile) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-too

# --- Production image (docker-compose.prod.yml) ---
IMAGE=ghcr.io/YOUR_USERNAME/devops-portfolio:latest
